<form id="nickname" class="nickname-form"
      hx-patch="<%= nickname_path %>" hx-trigger="submit, change" hx-target="#nickname" hx-swap="outerHTML">
  <label>
    Seu nome
    <input type="text" name="nickname" value="<%= current_nickname %>" maxlength="20" autocomplete="off">
  </label>
  <% if local_assigns[:saved] %><small class="saved">salvo ✓</small><% end %>
</form>
