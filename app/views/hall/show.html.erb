<% content_for :title, "#{l(@day)} · Chess Club" %>
<% content_for :main_class, "narrow" %>
<div class="stack">
  <div class="page-head">
    <h1>Resumo de <%= l(@day) %></h1>
    <p><span class="tag purple"><%= Arena::Theme.for(@day).name %></span><%= " · ainda em andamento, os números mudam até a meia-noite" if @live %></p>
  </div>

  <div class="cols-2">
    <section class="pane" aria-label="Resumo">
      <div class="pane-head"><span class="title">o dia</span></div>
      <div class="pane-body">
        <ul class="recap">
          <li>🏆 <strong>Campeão:</strong> <%= @recap.champion_name ? "#{@recap.champion_name} (#{@recap.champion_points} pts)" : "ninguém pontuou" %></li>
          <li>🔮 <strong>Melhor palpiteiro:</strong> <%= @recap.best_predictor_name ? "#{@recap.best_predictor_name} (#{count_pt(@recap.best_predictor_correct, 'acerto')})" : "—" %></li>
          <li>⚡ <strong>Mate mais rápido:</strong> <%= @recap.fastest_mate_winner ? "#{@recap.fastest_mate_winner} em #{@recap.fastest_mate_moves} lances" : "—" %></li>
          <li>🐢 <strong>Partida mais longa:</strong> <%= @recap.longest_game_moves ? "#{@recap.longest_game_moves} lances" : "—" %></li>
          <li>📊 <%= count_pt(@recap.games_count, "partida") %> · <%= count_pt(@recap.players_count, "jogador", "jogadores") %></li>
        </ul>
      </div>
    </section>
    <section class="pane" data-controller="clipboard" aria-label="Compartilhar">
      <div class="pane-head"><span class="title">compartilhar</span><span>pronto para o WhatsApp</span></div>
      <div class="pane-body stack" style="gap: 8px;">
        <textarea readonly rows="7" data-clipboard-target="source" aria-label="Texto para compartilhar"><%= share_text(@recap) %></textarea>
        <button class="outline" data-action="clipboard#copy" data-clipboard-target="button">copiar texto</button>
      </div>
    </section>
  </div>

  <% if @players.any? %>
    <section class="pane" aria-label="Top 10">
      <div class="pane-head"><span class="title">top 10</span></div>
      <div class="pane-body">
        <ol class="top10">
          <% @players.each do |p| %>
            <li><b><%= p.name %></b> · <%= p.points %> pts (<%= p.wins %>V <%= p.draws %>E <%= p.losses %>D)</li>
          <% end %>
        </ol>
      </div>
    </section>
  <% end %>

  <p class="link-row"><%= link_to "← hall da fama", hall_path %><%= link_to "arena de hoje", rank_path %></p>
</div>
