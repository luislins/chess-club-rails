<% content_for :title, "#{@room.name} · Chess Club" %>

<%# Subscribes to the room channel (Action Cable / Solid Cable). Broadcasts replace #refresh below. %>
<%= turbo_stream_from @room %>
<div id="refresh"></div>

<div id="room" class="room">
  <section class="board-area">
    <hgroup>
      <h2><%= @room.name %></h2>
      <p><%= link_to "← todas as salas", root_path %></p>
    </hgroup>
    <%= render "rooms/board", room: @room, selected: nil, promotion: nil %>
  </section>

  <aside class="side">
    <%= render "rooms/game_info", room: @room, oob: false %>
    <%= render "rooms/me", room: @room, oob: false, prediction: @prediction %>

    <article class="chat">
      <header><strong>Chat</strong></header>
      <div id="messages" class="messages" data-controller="chat">
        <%= render @messages %>
      </div>
      <form hx-post="<%= room_messages_path(@room) %>" hx-swap="none"
            hx-on::after-request="if (event.detail.successful) this.reset()">
        <fieldset role="group">
          <input type="text" name="body" placeholder="Diga algo…" maxlength="300" required autocomplete="off">
          <button type="submit">Enviar</button>
        </fieldset>
      </form>
    </article>
  </aside>
</div>
