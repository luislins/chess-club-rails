<% content_for :title, "Bem-vindo · Chess Club" %>
<article class="welcome">
  <hgroup>
    <h1>♞ Bem-vindo ao Chess Club</h1>
    <p>Sem cadastro. Diga só como quer ser chamado e vamos jogar.</p>
  </hgroup>
  <%= form_with url: welcome_path, method: :post do |f| %>
    <fieldset role="group">
      <%= f.text_field :nickname, placeholder: "Seu nome", required: true, minlength: 2, maxlength: 20,
                       autofocus: true, autocomplete: "nickname", value: params[:nickname] %>
      <%= f.submit "Entrar" %>
    </fieldset>
  <% end %>
  <small>Você pode mudar o nome depois, no canto superior da página.</small>
</article>
