<% content_for :title, "Hoje · Chess Club" %>
<% content_for :main_class, "narrow" %>
<div class="stack">
  <div class="page-head">
    <h1>Arena de hoje · <%= l(@day) %></h1>
    <p><span class="tag purple"><%= @theme.name %></span> · o placar zera à meia-noite (<%= time_ago_in_words(@midnight) %> restantes)</p>
  </div>

  <%# htmx polling keeps the table fresh while people play %>
  <section id="rank" class="pane" aria-label="Ranking" hx-get="<%= rank_path %>" hx-trigger="every 15s" hx-select="#rank" hx-swap="outerHTML">
    <div class="pane-head">
      <span class="title">ranking</span>
      <span class="stats"><span><b><%= @games_count %></b> partidas contaram</span><span><b><%= @rooms_playing %></b> em andamento</span><span><b><%= @players.size %></b> jogadores</span></span>
    </div>
    <% if @players.empty? %>
      <div class="pane-body"><p class="empty">Ninguém entrou na arena ainda hoje.</p></div>
    <% else %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th class="num">#</th><th>jogador</th><th class="num">pts</th><th class="num">v</th><th class="num">e</th><th class="num">d</th><th class="num">seq.</th><th class="num">palpites</th></tr>
          </thead>
          <tbody>
            <% @players.each_with_index do |p, i| %>
              <tr class="<%= 'me' if p == current_player %>">
                <td class="num muted"><%= i + 1 %></td>
                <td><%= crowned_name(p.name, p.token) %><%= " (você)" if p == current_player %></td>
                <td class="num"><strong><%= p.points %></strong></td>
                <td class="num"><%= p.wins %></td><td class="num"><%= p.draws %></td><td class="num"><%= p.losses %></td>
                <td class="num"><%= p.streak >= 2 ? tag.span("🔥 #{p.streak}", class: "streak") : p.streak %></td>
                <td class="num text-2"><%= p.predictions_correct %>/<%= p.predictions_total %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <p class="link-row"><%= link_to "resumo de hoje", day_path(@day.iso8601) %><%= link_to "hall da fama", hall_path %></p>
</div>
